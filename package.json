{
  "name": "nook-sticky-notes",
  "version": "1.0.0",
  "description": "Nook Sticky Notes",
  "homepage": "https://isvxs.github.io/Nook/",
  "repository": {
    "type": "git",
    "url": "https://github.com/isvxs/Nook.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.hevmys.nook",
    "productName": "Nook",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "NookB.png",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "isvxs",
      "repo": "Nook"
    }
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}